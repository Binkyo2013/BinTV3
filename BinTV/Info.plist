<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>vi</string>
	<key>CFBundleDisplayName</key>
	<string>BinTV</string>
	<key>CFBundleExecutable</key>
	<string>BinTV</string>
	<key>CFBundleIdentifier</key>
	<string>com.bintv.ios</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>BinTV</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>2.5.4</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>235</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- [build 231 — 2026-09-13] MỞ ATS CHO TẢI HTTP/HTTPS.
	     Lý do: nguồn phim từ Stremio addon (vnstream/viptorrent/vimo/sc.k-20…)
	     rất thường là link http:// (CDN VN/Asia). ATS mặc định CHẶN mọi
	     request cleartext của framework Apple — gồm cả PhimLocalServer.swift
	     (URLSession/RawHttp) và AVPlayer khi phát streamUrl trực tiếp
	     (BinTV/Player/PhimNativePlayerController.swift) → video không khởi
	     chạy. NSAllowsArbitraryLoads=true mở cả http lẫn https cho toàn app
	     (app sideload TrollStore, không qua App Store review).
	     GIỮ LẠI NSAllowsLocalNetworking + NSExceptionDomains cũ: chúng vô hại
	     khi arbitrary loads bật, và nếu sau này siết ATS lại thì cấu hình
	     chi tiết cho server nội bộ (127.0.0.1) và 2 host đã biết vẫn còn. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>85.237.89.160</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>stream.mcquack.net</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UILandscapeLeftInterfaceOrientation</string>
		<string>UILandscapeRightInterfaceOrientation</string>
	</array>
	<!-- [FIX 2026-09-12] iPad (TARGETED_DEVICE_FAMILY = 1,2): khai báo
	     TƯỜNG MINH biến thể ~ipad landscape-only. UIRequiresFullScreen=YES
	     nên iPad KHÔNG bị ràng buộc "phải hỗ trợ mọi hướng cho
	     multitasking" — 2 key nhất quán 100%, không còn phụ thuộc suy
	     luận fallback của hệ thống. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UILandscapeLeftInterfaceOrientation</string>
		<string>UILandscapeRightInterfaceOrientation</string>
	</array>
</dict>
</plist>
